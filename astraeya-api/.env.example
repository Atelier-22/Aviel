# Astraeya API — environment configuration
# Copy to .env for local development. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Local: a Postgres you run yourself.
# Production: Render's External Database URL (starts with postgresql://).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astraeya"

# --- Auth ---
# Signs the bearer tokens used by both the web and mobile clients.
# Generate one with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="30d"

# --- AI provider ---
# Without this, /chat returns a clear 503 instead of a fake response.
ANTHROPIC_API_KEY=""
# Any current Claude model id. Sonnet 5.5 is the default; claude-opus-5-5 is
# more capable and more expensive.
ANTHROPIC_MODEL="claude-sonnet-5-5"

# --- Image, logo and video generation (fal.ai) ---
# Without this key the assistant can still make slideshow videos, but says
# plainly that it cannot make pictures, logos or AI video. Get a key at
# https://fal.ai/dashboard/keys. Costs are per use; limits are in the admin
# dashboard (images and videos per day, daily spend per user).
FAL_KEY=""
# The API's public address, so the video service can say when a video is ready.
# Optional: without it, finished videos are found by polling a few seconds later.
# PUBLIC_API_URL="https://astraeya-api.onrender.com"

# --- Instant speech (optional) ---
# DeepInfra runs the same Kokoro voices (Heart included) and Whisper on GPUs:
# speech starts in a fraction of a second instead of seconds on a CPU. Unset,
# Astraeya's own voice server does both. With it, reply text and Astra Assist
# recordings go to DeepInfra. Get a key at https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=""

# --- CORS ---
# Comma-separated browser origins allowed to call this API. The deployed
# frontend's URL goes here. *.vercel.app preview URLs are allowed automatically.
CORS_ORIGINS="http://localhost:3000"

# --- Optional: web search tool (not implemented yet) ---
# WEB_SEARCH_PROVIDER=""
